mainmenu "EASNFW-SENSOR"

menu "EASNFW-SENSOR image"

choice EASNFW_IMAGE_TYPE
	prompt "Image type"
	default EASNFW_IMAGE_TYPE_DEVELOPMENT

config EASNFW_IMAGE_TYPE_PRODUCTION
	bool "Production image"

config EASNFW_IMAGE_TYPE_DEVELOPMENT
	bool "Development image"

config EASNFW_IMAGE_TYPE_DEBUG
	bool "Debug image"

config EASNFW_IMAGE_TYPE_HIL
	bool "HIL verification image"
	depends on SHELL && SHELL_BACKEND_SERIAL && REBOOT

endchoice

config EASNFW_VERIFICATION_CODE
	def_bool EASNFW_IMAGE_TYPE_HIL

config EASNFW_TRACK_LEN_SECONDS
	int "Audio track duration (seconds)"
	default 60
	range 1 3600

config EASNFW_INTER_TRACK_INTERVAL_SECONDS
	int "Interval between audio tracks (seconds)"
	default 840
	range 0 86400

config EASNFW_MAX_RECOVERY_RESETS
	int "Reset-history capacity"
	default 5
	range 1 32

config EASNFW_RECOVERY_RESET_WINDOW_SECONDS
	int "Recovery reset stability window (seconds)"
	default 120
	range 1 86400

config EASNFW_UTC_SYNC_RETRY_SECONDS
	int "Retry interval while waiting for UTC synchronization (seconds)"
	default 30
	range 1 3600

config EASNFW_AUDIO_SAMPLE_RATE_HZ
	int "Audio sample rate (Hz)"
	default 48000
	range 8000 96000

config EASNFW_AUDIO_SAMPLES_PER_BLOCK
	int "Audio samples per processing block"
	default 1536
	range 64 8192

config EASNFW_IFL_RX_MSGQ_SIZE
	int "Inter-FW link receive queue depth"
	default 8
	range 1 32

endmenu

menuconfig EASNFW_IFL_UART
	bool "EASNFW UART link"
	default y
	depends on SERIAL && UART_ASYNC_API && RING_BUFFER
	depends on UART_2_ASYNC && UART_USE_RUNTIME_CONFIGURE

if EASNFW_IFL_UART

config EASNFW_IFL_UART_MAX_PAYLOAD
	int "Max payload bytes per frame"
	default 512
	range 16 4096

config EASNFW_IFL_UART_ACK_TIMEOUT_MS
	int "ACK timeout (ms)"
	default 100
	range 5 5000

config EASNFW_IFL_UART_MAX_RETRIES
	int "Max retransmissions"
	default 10
	range 0 20

config EASNFW_IFL_UART_RX_INTERBYTE_TIMEOUT_MS
	int "RX idle timeout (ms)"
	default 2
	range 1 1000

config EASNFW_IFL_UART_RX_RING_BUF_SIZE
	int "RX ring buffer size (bytes)"
	default 2048
	help
	  Size for worst-case service latency at the configured baud rate.

endif # EASNFW_IFL_UART

source "Kconfig.zephyr"
