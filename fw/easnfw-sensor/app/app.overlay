/*
 * Route the nRF5340 audio serial port to the external microphone header.
 */
&gpio0 {
	codec-interface {
		/delete-property/ output-low;
		output-high;
	};
};

&pinctrl {
	easnfw_i2s_default: easnfw_i2s_default {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 0, 14)>,
				<NRF_PSEL(I2S_LRCK_M, 0, 16)>,
				<NRF_PSEL(I2S_SDIN, 0, 15)>;
		};
	};

	easnfw_i2s_sleep: easnfw_i2s_sleep {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 0, 14)>,
				<NRF_PSEL(I2S_LRCK_M, 0, 16)>,
				<NRF_PSEL(I2S_SDIN, 0, 15)>;
			low-power-enable;
		};
	};
};

&i2s0 {
	status = "okay";
	pinctrl-0 = <&easnfw_i2s_default>;
	pinctrl-1 = <&easnfw_i2s_sleep>;
	pinctrl-names = "default", "sleep";
};